    "jszip": "^3.10.2",
    "midi-file": "^1.2.4",
    "opensheetmusicdisplay": "^2.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
